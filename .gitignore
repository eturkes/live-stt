# Virtual environments (per-layer: .venv = container, .venv-host = host; see .envrc)
.venv/
.venv-host/

# direnv cache (committed .envrc picks the per-layer uv venv)
.direnv/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Build artifacts
dist/
build/

# Tool caches
.ruff_cache/
.pytest_cache/

# Bench corpus WAVs (gitignored; the replay.py / test regression corpus, D-014)
spike/backends/cache/

# Saved sessions: one transcript file per run, written by default (TRANSCRIPT_DIR)
transcripts/

# Captured run output (redirected live sessions, e.g. `uv run live-stt 2> stt.log`)
*.log

# Local STT model weights (download via models/README.md; large binaries)
models/*
!models/README.md

# Claude Code per-user overrides (committed counterparts: CLAUDE.md, .claude/agents/, .claude/rules/)
.claude/settings.local.json
CLAUDE.local.md

# Session workspace: teammate roster/reports + per-teammate git worktrees (`CLAUDE.md`'s `Teammates`); nothing durable
.scratch/

# Environment / secrets
.env
.env.*
*.key

# OS
.DS_Store
Thumbs.db
