.venv/
.venv-host/

# direnv cache (committed .envrc picks the per-layer uv venv)
.direnv/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Build artifacts
dist/
build/

# Tool caches
.ruff_cache/
.pytest_cache/

# Bench corpus WAVs (gitignored; the replay.py / test regression corpus, D-014)
spike/backends/cache/

# Local STT model weights (download via models/README.md; large binaries)
models/*
!models/README.md

# Environment / secrets
.env
.env.*
*.key

# OS
.DS_Store
Thumbs.db
