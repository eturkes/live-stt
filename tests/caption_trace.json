{
  "source": {
    "wav": "spike/backends/cache/gongitsune_01.wav",
    "wav_sha256": "a70d7443fcaf5c1c56ed278f1c25a8dbf7558aeb62d9a02b738e9077ef5509b3",
    "manifest": "tests/long_form.json",
    "audio_s": 288.5210625
  },
  "run": {
    "engine": "whisper",
    "requested_device": "NPU",
    "placement": "exact-target inference: check_device admits exact names only and 'NPU' decoded successfully; WhisperPipeline exposes no compiled model, so EXECUTION_DEVICES is unreadable",
    "hotwords_reachable": false,
    "n_captions": 67,
    "n_nonempty": 67,
    "total_decode_s": 284.6727580850056,
    "overall_rtf": 0.9866619636651505
  },
  "captions": [
    {
      "idx": 1,
      "start_s": 1.104,
      "end_s": 2.368,
      "dur_s": 1.264,
      "decode_s": 0.99526288099878,
      "text": "1"
    },
    {
      "idx": 2,
      "start_s": 2.832,
      "end_s": 5.504,
      "dur_s": 2.672,
      "decode_s": 1.1856040109960304,
      "text": "これは私私が小さい時に、"
    },
    {
      "idx": 3,
      "start_s": 5.488,
      "end_s": 9.344,
      "dur_s": 3.856,
      "decode_s": 1.8937311890003912,
      "text": "村のモヘイというおじいさんから聞いたお話です。"
    },
    {
      "idx": 4,
      "start_s": 10.16,
      "end_s": 11.424,
      "dur_s": 1.264,
      "decode_s": 0.8883348710041901,
      "text": "昔は"
    },
    {
      "idx": 5,
      "start_s": 11.376,
      "end_s": 16.48,
      "dur_s": 5.104,
      "decode_s": 3.358780906000902,
      "text": "私たちの村の近くの中山というところに小さなお城があって、"
    },
    {
      "idx": 6,
      "start_s": 16.592,
      "end_s": 20.128,
      "dur_s": 3.536,
      "decode_s": 2.8567080160028127,
      "text": "中山様というお殿様がおられたそうです"
    },
    {
      "idx": 7,
      "start_s": 20.944,
      "end_s": 23.008,
      "dur_s": 2.064,
      "decode_s": 1.9696521110017784,
      "text": "その中山から、"
    },
    {
      "idx": 8,
      "start_s": 22.864,
      "end_s": 24.928,
      "dur_s": 2.064,
      "decode_s": 2.225406027002464,
      "text": "少し離れた山の中に"
    },
    {
      "idx": 9,
      "start_s": 24.88,
      "end_s": 27.616,
      "dur_s": 2.736,
      "decode_s": 2.2522143719979795,
      "text": "ゴギツネというキツネがいました。"
    },
    {
      "idx": 10,
      "start_s": 28.144,
      "end_s": 30.848,
      "dur_s": 2.704,
      "decode_s": 2.460703070002637,
      "text": "ゴンはひとりぼっちのこにつねで"
    },
    {
      "idx": 11,
      "start_s": 30.992,
      "end_s": 35.52,
      "dur_s": 4.528,
      "decode_s": 4.577607914998225,
      "text": "舌のいっぱい茂った森の中に、穴を掘って棲んでいました。"
    },
    {
      "idx": 12,
      "start_s": 36.08,
      "end_s": 37.28,
      "dur_s": 1.2,
      "decode_s": 1.3775349659954372,
      "text": "そして"
    },
    {
      "idx": 13,
      "start_s": 37.136,
      "end_s": 42.496,
      "dur_s": 5.36,
      "decode_s": 55.741486474998965,
      "text": "夜でも昼でもあたりの村へ出てきて、いたずらばかりしました。"
    },
    {
      "idx": 14,
      "start_s": 42.928,
      "end_s": 45.984,
      "dur_s": 3.056,
      "decode_s": 11.91523348299961,
      "text": "畑へ入って芋を掘り散らしたり"
    },
    {
      "idx": 15,
      "start_s": 46.064,
      "end_s": 49.408,
      "dur_s": 3.344,
      "decode_s": 21.107158957998763,
      "text": "ナタネガラの干しであるのへ火をつけたり、"
    },
    {
      "idx": 16,
      "start_s": 49.392,
      "end_s": 56.16,
      "dur_s": 6.768,
      "decode_s": 5.592145550999703,
      "text": "百姓屋の裏手に吊るしてある 唐辛子をむしり取って行ったりり、いろんなことをしました。"
    },
    {
      "idx": 17,
      "start_s": 57.072,
      "end_s": 59.552,
      "dur_s": 2.48,
      "decode_s": 1.9666485590023512,
      "text": "ある、秋のことでした。"
    },
    {
      "idx": 18,
      "start_s": 59.824,
      "end_s": 62.784,
      "dur_s": 2.96,
      "decode_s": 2.186200722000649,
      "text": "2、3日、雨は降り続いたその間、"
    },
    {
      "idx": 19,
      "start_s": 62.672,
      "end_s": 67.392,
      "dur_s": 4.72,
      "decode_s": 3.7146839750021172,
      "text": "ゴンは外へも出られなくて穴の中ににしゃがんでいました。"
    },
    {
      "idx": 20,
      "start_s": 68.624,
      "end_s": 72.736,
      "dur_s": 4.112,
      "decode_s": 3.665082468007313,
      "text": "雨が上がると、ゴンはほっとして穴からはい出ました。"
    },
    {
      "idx": 21,
      "start_s": 73.52,
      "end_s": 75.872,
      "dur_s": 2.352,
      "decode_s": 1.914207745998283,
      "text": "空はカラッと晴れていて、"
    },
    {
      "idx": 22,
      "start_s": 75.952,
      "end_s": 79.328,
      "dur_s": 3.376,
      "decode_s": 2.9451075969991507,
      "text": "モズの声が、きんきん響いていました。"
    },
    {
      "idx": 23,
      "start_s": 80.56,
      "end_s": 84.256,
      "dur_s": 3.696,
      "decode_s": 2.9020917380003084,
      "text": "ゴンは村の側の包みまで出てきました。"
    },
    {
      "idx": 24,
      "start_s": 84.912,
      "end_s": 89.696,
      "dur_s": 4.784,
      "decode_s": 3.8705376909965707,
      "text": "あたりのすすきのほうには、まだ雨のしずくが光っていました。"
    },
    {
      "idx": 25,
      "start_s": 90.512,
      "end_s": 93.504,
      "dur_s": 2.992,
      "decode_s": 2.17962015699959,
      "text": "川はいつもは水が少ないのですが、"
    },
    {
      "idx": 26,
      "start_s": 93.584,
      "end_s": 96.96,
      "dur_s": 3.376,
      "decode_s": 3.0107846350001637,
      "text": "三日もの雨で、水がどっと増していました。"
    },
    {
      "idx": 27,
      "start_s": 97.84,
      "end_s": 103.008,
      "dur_s": 5.168,
      "decode_s": 4.883678209003847,
      "text": "ただの時は水に浸かることのない川べりのすすきや萩の株が、"
    },
    {
      "idx": 28,
      "start_s": 103.024,
      "end_s": 107.008,
      "dur_s": 3.984,
      "decode_s": 3.1374959929999022,
      "text": "黄色く濁った水に横倒しになって揉まれています。"
    },
    {
      "idx": 29,
      "start_s": 107.696,
      "end_s": 112.192,
      "dur_s": 4.496,
      "decode_s": 3.826181431002624,
      "text": "ゴンは川下の方へとぬかるみ道を歩いていきました。"
    },
    {
      "idx": 30,
      "start_s": 113.488,
      "end_s": 117.568,
      "dur_s": 4.08,
      "decode_s": 3.012521550997917,
      "text": "ふと見ると、川の中に人がいて、何かやっています。"
    },
    {
      "idx": 31,
      "start_s": 118.096,
      "end_s": 122.976,
      "dur_s": 4.88,
      "decode_s": 3.9501126350005507,
      "text": "ゴンは見つからないように、そっと草のの深いところへ歩き寄って、"
    },
    {
      "idx": 32,
      "start_s": 122.864,
      "end_s": 125.408,
      "dur_s": 2.544,
      "decode_s": 2.093416513998818,
      "text": "そこからじっとのぞいてみました。"
    },
    {
      "idx": 33,
      "start_s": 126.288,
      "end_s": 129.024,
      "dur_s": 2.736,
      "decode_s": 2.2198117890002322,
      "text": "標柱だなとゴンは思いました。"
    },
    {
      "idx": 34,
      "start_s": 129.552,
      "end_s": 133.152,
      "dur_s": 3.6,
      "decode_s": 3.237905779002176,
      "text": "標柱はボロボロの黒い着物をまくしあげて、"
    },
    {
      "idx": 35,
      "start_s": 133.136,
      "end_s": 135.776,
      "dur_s": 2.64,
      "decode_s": 2.2635156409960473,
      "text": "腰のところまで水に浸りながら"
    },
    {
      "idx": 36,
      "start_s": 135.696,
      "end_s": 139.904,
      "dur_s": 4.208,
      "decode_s": 3.798488610998902,
      "text": "魚を捕るハレキリといういうあみをゆすぶっていました"
    },
    {
      "idx": 37,
      "start_s": 140.656,
      "end_s": 147.68,
      "dur_s": 7.024,
      "decode_s": 5.524201950000133,
      "text": "鉢巻きをした顔の横っちょうに、丸い萩の葉が一枚、大きなほくろみたいにへばれついていました。"
    },
    {
      "idx": 38,
      "start_s": 148.976,
      "end_s": 152.896,
      "dur_s": 3.92,
      "decode_s": 2.5361249140005384,
      "text": "しばらくすると標柱は、張り切り編みの一番後ろの、"
    },
    {
      "idx": 39,
      "start_s": 152.784,
      "end_s": 156.608,
      "dur_s": 3.824,
      "decode_s": 2.7929351430029783,
      "text": "袋のようになったところを水の中から持ち上げました。"
    },
    {
      "idx": 40,
      "start_s": 157.2,
      "end_s": 160.864,
      "dur_s": 3.664,
      "decode_s": 2.7456450600038806,
      "text": "その中には、ヒバの根や、草の葉や、"
    },
    {
      "idx": 41,
      "start_s": 160.976,
      "end_s": 164.448,
      "dur_s": 3.472,
      "decode_s": 2.821342333998473,
      "text": "あった木切れなどがこちゃこちゃ入っていましたが"
    },
    {
      "idx": 42,
      "start_s": 164.432,
      "end_s": 168.704,
      "dur_s": 4.272,
      "decode_s": 4.037166116002481,
      "text": "でも、ところどころ、白いものは、 キラキラ光っています。"
    },
    {
      "idx": 43,
      "start_s": 169.04,
      "end_s": 174.144,
      "dur_s": 5.104,
      "decode_s": 3.769199684003979,
      "text": "それは、太いウナギの腹や大きなキスの腹でした。"
    },
    {
      "idx": 44,
      "start_s": 174.576,
      "end_s": 180.608,
      "dur_s": 6.032,
      "decode_s": 4.462957404997724,
      "text": "標柱は鼻腔の中へそのうなぎやキスをゴミと一緒にぶち込みました"
    },
    {
      "idx": 45,
      "start_s": 181.04,
      "end_s": 185.536,
      "dur_s": 4.496,
      "decode_s": 3.7781977820086468,
      "text": "そしてまた、ふくろの口をしばっってみずのなかへいれました。"
    },
    {
      "idx": 46,
      "start_s": 186.544,
      "end_s": 190.56,
      "dur_s": 4.016,
      "decode_s": 2.8895987719952245,
      "text": "標柱はそれから、鼻腔を持ってから上がり、"
    },
    {
      "idx": 47,
      "start_s": 190.512,
      "end_s": 196.224,
      "dur_s": 5.712,
      "decode_s": 4.359128261996375,
      "text": "びくを土手に置いといて、何を探しにか、川上の方へかけていきました。"
    },
    {
      "idx": 48,
      "start_s": 197.392,
      "end_s": 204.096,
      "dur_s": 6.704,
      "decode_s": 5.309121389997017,
      "text": "標準がいなくなると、ゴンはぴょいと草の中から飛び出して、鼻腔のそばへ駆けつき合いました。"
    },
    {
      "idx": 49,
      "start_s": 204.656,
      "end_s": 207.424,
      "dur_s": 2.768,
      "decode_s": 2.000073176001024,
      "text": "ちょいといたずらがしたくなったのです"
    },
    {
      "idx": 50,
      "start_s": 207.952,
      "end_s": 217.792,
      "dur_s": 9.84,
      "decode_s": 8.19690406400332,
      "text": "ゴンは、鼻腔の中の魚をつかみ出しては、ては、はりきりあみのかかっているところより、しもてのかわのなかをめがけて、ぽんぽん、なぎこみました。"
    },
    {
      "idx": 51,
      "start_s": 218.512,
      "end_s": 224.928,
      "dur_s": 6.416,
      "decode_s": 5.219051562999084,
      "text": "どの魚も、とぼんと音を立てながら、濁った水の中へもぎりこみました。"
    },
    {
      "idx": 52,
      "start_s": 225.808,
      "end_s": 227.264,
      "dur_s": 1.456,
      "decode_s": 1.0380129969998961,
      "text": "一番しまいに"
    },
    {
      "idx": 53,
      "start_s": 227.152,
      "end_s": 229.728,
      "dur_s": 2.576,
      "decode_s": 1.857558990999678,
      "text": "太いうなぎをつかみにかかりましたが"
    },
    {
      "idx": 54,
      "start_s": 229.776,
      "end_s": 234.496,
      "dur_s": 4.72,
      "decode_s": 3.7496888489986304,
      "text": "何しろぬるぬるとすばり抜けるので、ではつかめません。"
    },
    {
      "idx": 55,
      "start_s": 234.768,
      "end_s": 239.168,
      "dur_s": 4.4,
      "decode_s": 3.297647937997681,
      "text": "ゴンはじれったくなって、頭をびくの中に突っ込んで、"
    },
    {
      "idx": 56,
      "start_s": 239.056,
      "end_s": 241.792,
      "dur_s": 2.736,
      "decode_s": 1.7957365679976647,
      "text": "うなぎの頭を口にくわえました"
    },
    {
      "idx": 57,
      "start_s": 242.064,
      "end_s": 246.016,
      "dur_s": 3.952,
      "decode_s": 2.501523040999018,
      "text": "うなぎはキュッと言ってゴンの首へ巻きつきました。"
    },
    {
      "idx": 58,
      "start_s": 246.288,
      "end_s": 249.088,
      "dur_s": 2.8,
      "decode_s": 1.68659933500021,
      "text": "その途端に、標柱が向こうから、"
    },
    {
      "idx": 59,
      "start_s": 249.552,
      "end_s": 253.376,
      "dur_s": 3.824,
      "decode_s": 2.746894173997134,
      "text": "わぁ、ぬすとぎすねめ、とどんなり立てました。"
    },
    {
      "idx": 60,
      "start_s": 253.808,
      "end_s": 256.288,
      "dur_s": 2.48,
      "decode_s": 1.6306234340008814,
      "text": "ゴンはびっくりして飛び上がりました。"
    },
    {
      "idx": 61,
      "start_s": 256.72,
      "end_s": 259.68,
      "dur_s": 2.96,
      "decode_s": 2.0620328719996905,
      "text": "うなぎをふり捨てて逃げようとしましたが"
    },
    {
      "idx": 62,
      "start_s": 259.632,
      "end_s": 263.264,
      "dur_s": 3.632,
      "decode_s": 2.8057337849968462,
      "text": "うなぎはごんのくびにまきついたままはなれません。"
    },
    {
      "idx": 63,
      "start_s": 263.6,
      "end_s": 268.864,
      "dur_s": 5.264,
      "decode_s": 4.84954096599904,
      "text": "ゴンはそのまま横飛びに飛び出して一生懸命に逃げていきました"
    },
    {
      "idx": 64,
      "start_s": 269.52,
      "end_s": 273.568,
      "dur_s": 4.048,
      "decode_s": 2.904521684999054,
      "text": "掘ラー穴の近くのハンノキの下で振り返ってみましたが、"
    },
    {
      "idx": 65,
      "start_s": 273.52,
      "end_s": 276.288,
      "dur_s": 2.768,
      "decode_s": 1.709265712997876,
      "text": "標柱は追っかけては来ませんでした"
    },
    {
      "idx": 66,
      "start_s": 276.848,
      "end_s": 285.344,
      "dur_s": 8.496,
      "decode_s": 7.471411106005689,
      "text": "ゴンはほっとしてウナギの頭を噛み砕き、やっとはずして穴の外の草の葉の上にのせておきました。"
    },
    {
      "idx": 67,
      "start_s": 286.896,
      "end_s": 288.032,
      "dur_s": 1.136,
      "decode_s": 0.948660772999574,
      "text": "終わり"
    }
  ]
}
