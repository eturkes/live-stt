# direnv: select uv's per-layer project venv by the path the working tree is
# accessed at — the ground truth for which venv's hardcoded absolute paths resolve.
# The Debian dev container sees the host tree under /run/host/...; the host sees it
# at its own path (no /run/host prefix). A venv built for one layer is invalid at
# the other, so a bare `uv sync` against the wrong venv rebuilds (clobbers) it:
# a host run would overwrite the container's .venv with host paths and vice versa.
# Host = the live-mic runtime (lowest latency); container = agent dev/test.
# direnv acts only in an allowed, hooked, interactive shell; elsewhere (scripts,
# git hooks, fresh shells, before `direnv allow`) export UV_PROJECT_ENVIRONMENT
# yourself. Pattern shared with ../pose-estimation.
case "$PWD" in
  /run/host/*) export UV_PROJECT_ENVIRONMENT=.venv ;;      # in-container (canonical; uv's default)
  *)           export UV_PROJECT_ENVIRONMENT=.venv-host ;; # host (live-mic runs)
esac

# Both layers put an OpenVINO Python tree on PYTHONPATH before this file runs:
# the host ~/.profile sources the GenAI tarball's setupvars.sh, the container's
# intel-accel/env.sh prepends its own. Either shadows the wheels uv installs
# here, and both trees ship py_openvino_genai for CPython 3.10-3.13 only, so
# under this project's 3.14 `import openvino_genai` dies on a missing extension.
unset PYTHONPATH

# The same trees put their runtime libs on LD_LIBRARY_PATH, which outranks
# py_openvino_genai's RUNPATH: a tarball whose soname matches the wheel's (both
# 2026.4.0 = .2640) silently swaps in its own libopenvino_genai build. Drop every
# entry that ships an OpenVINO core or TBB, so the wheels resolve from themselves;
# the intel-accel farm ships neither and stays, since the container NPU needs it.
# Plain bash, no direnv stdlib: agent shells `source .envrc` after env.sh.
# The live CLI does not depend on this: its supervisor applies the same rule
# to the session child (live_stt._session_env).
_ld=
IFS=: read -ra _dirs <<<"${LD_LIBRARY_PATH:-}"
for _d in "${_dirs[@]}"; do
  [ -n "$_d" ] || continue
  compgen -G "$_d/libopenvino.so*" >/dev/null || compgen -G "$_d/libtbb.so*" >/dev/null ||
    _ld=${_ld:+$_ld:}$_d
done
if [ -n "$_ld" ]; then export LD_LIBRARY_PATH=$_ld; else unset LD_LIBRARY_PATH; fi
unset _ld _dirs _d

# Both layers keep the uv cache on a different filesystem from this tree, so
# hardlinking fails and uv falls back to copying with a warning (observed on
# host and in-container, 2026-07-02). Copy mode is that same fallback, quiet.
export UV_LINK_MODE=copy
